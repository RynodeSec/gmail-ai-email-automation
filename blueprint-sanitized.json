            "required": false
          },
          {
            "name": "genuineAdvertising",
            "type": "boolean",
            "label": "Genuine advertising",
            "required": false
          },
          {
            "name": "deletionRecommended",
            "type": "boolean",
            "label": "Deletion recommended",
            "required": false
          },
          {
            "name": "linkedinProfileView",
            "type": "boolean",
