{
  "name": "Integration Gmail, Google Gemini AI",
  "flow": [
    {
      "id": 1,
      "module": "google-email:triggerWatchNewEmails",
      "version": 4,
      "parameters": {
        "limit": 10,
        "folder": "INBOX",
        "format": "full",
        "criteria": "all",
        "markSeen": false,
        "filterType": "simpleSearch",
        "__IMTCONN__": "REPLACE_WITH_YOUR_MAKE_CONNECTION_ID",
        "hasAttachment": false
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "parameters": {
            "folder": {
              "mode": "chose",
              "label": "Inbox"
            },
            "format": {
              "mode": "chose",
              "label": "Full content"
            },
            "criteria": {
              "mode": "chose",
              "label": "All messages"
            },
            "filterType": {
              "mode": "chose",
              "label": "Simple filter",
              "nested": [
                {
                  "name": "folder",
                  "type": "select",
                  "label": "Folder",
                  "default": "INBOX",
                  "grouped": true,
                  "options": "rpc://google-email@4/listFolders?labelType=system,category&includeAllFolders=true",
                  "required": true
                },
                {
                  "name": "labelIds",
                  "type": "select",
                  "label": "Label",
                  "options": "rpc://google-email@4/listFolders?labelType=user"
                },
                {
                  "name": "criteria",
                  "type": "select",
                  "label": "Criteria",
                  "options": [
                    {
                      "label": "All messages",
                      "value": "all",
                      "default": true
                    },
                    {
                      "label": "Only read messages",
                      "value": "is:read"
                    },
                    {
                      "label": "Only unread messages",
                      "value": "is:unread"
                    }
                  ],
                  "required": true
                },
                {
                  "name": "markSeen",
                  "type": "boolean",
                  "label": "Mark email message(s) as read when fetched",
                  "default": false
                },
                {
                  "help": "Maximum number of results to return and work with during one execution cycle. For information about setting limits, see our [Help Center](https://help.make.com/types-of-modules#module-limits).",
                  "name": "limit",
                  "type": "uinteger",
                  "label": "Limit",
                  "default": 10,
                  "required": true,
                  "validate": {
                    "max": 500
                  }
                },
                {
                  "help": "Processes only emails sent from a specified email address.",
                  "name": "from",
                  "type": "email",
                  "label": "Sender email address",
                  "advanced": true
                },
                {
                  "help": "Processes only emails that contain a specified character string in the subject.",
                  "name": "subject",
                  "type": "text",
                  "label": "Subject",
                  "advanced": true
                },
                {
                  "help": "Processes only emails that contain a specified character string (anywhere).",
                  "name": "includeWords",
                  "type": "text",
                  "label": "Has the words",
                  "advanced": true
                },
                {
                  "help": "Processes only emails that do not contain a specified character string (anywhere).",
                  "name": "excludeWords",
                  "type": "text",
                  "label": "Doesn't have",
                  "advanced": true
                },
                {
                  "name": "size",
                  "spec": [
                    {
                      "name": "criteria",
                      "type": "select",
                      "label": "Criteria",
                      "options": [
                        {
                          "label": "Greater than",
                          "value": "larger",
                          "default": true
                        },
                        {
                          "label": "Less than",
                          "value": "smaller"
                        }
                      ]
                    },
                    {
                      "name": "amount",
                      "type": "integer",
                      "label": "Size",
                      "validate": {
                        "min": 0
                      }
                    },
                    {
                      "name": "unit",
                      "type": "select",
                      "label": "Size unit",
                      "options": [
                        {
                          "label": "MB (megabytes)",
                          "value": "M",
                          "default": true
                        },
                        {
                          "label": "KB (kilobytes)",
                          "value": "K"
                        },
                        {
                          "label": "Bytes",
                          "value": "bytes"
                        }
                      ]
                    }
                  ],
                  "type": "collection",
                  "label": "Email size",
                  "advanced": true
                },
                {
                  "help": "Setting this to `No` will include emails with and without attachments.",
                  "name": "hasAttachment",
                  "type": "boolean",
                  "label": "Only emails with attachments/media",
                  "default": false,
                  "advanced": true,
                  "required": true
                }
              ]
            },
            "__IMTCONN__": "REPLACE_WITH_YOUR_MAKE_CONNECTION_ID"
          }
        },
        "parameters": [
          {
            "on": {
              "change": "reset_epoch"
            },
            "name": "__IMTCONN__",
            "type": "account:google-email",
            "label": "Connection",
            "required": true
          },
          {
            "name": "filterType",
            "type": "select",
            "label": "Filter type",
            "required": true,
            "validate": {
              "enum": [
                "simpleSearch",
                "gmailSearch"
              ]
            }
          },
          {
            "name": "folder",
            "type": "select",
            "label": "Folder",
            "default": "INBOX",
            "grouped": true,
            "required": true
          },
          {
            "name": "labelIds",
            "type": "select",
            "label": "Label"
          },
          {
            "name": "criteria",
            "type": "select",
            "label": "Criteria",
            "required": true,
            "validate": {
              "enum": [
                "all",
                "is:read",
                "is:unread"
              ]
            }
          },
          {
            "name": "markSeen",
            "type": "boolean",
            "label": "Mark email message(s) as read when fetched",
            "default": false
          },
          {
            "name": "limit",
            "type": "uinteger",
            "label": "Limit",
            "default": 10,
            "required": true,
            "validate": {
              "max": 500
            }
          },
          {
            "name": "from",
            "type": "email",
            "label": "Sender email address",
            "advanced": true
          },
          {
            "name": "subject",
            "type": "text",
            "label": "Subject",
            "advanced": true
          },
          {
            "name": "includeWords",
            "type": "text",
            "label": "Has the words",
            "advanced": true
          },
          {
            "name": "excludeWords",
            "type": "text",
            "label": "Doesn't have",
            "advanced": true
          },
          {
            "name": "size",
            "spec": [
              {
                "name": "criteria",
                "type": "select",
                "label": "Criteria",
                "validate": {
                  "enum": [
                    "larger",
                    "smaller"
                  ]
                }
              },
              {
                "name": "amount",
                "type": "integer",
                "label": "Size",
                "validate": {
                  "min": 0
                }
              },
              {
                "name": "unit",
                "type": "select",
                "label": "Size unit",
                "validate": {
                  "enum": [
                    "M",
                    "K",
                    "bytes"
                  ]
                }
              }
            ],
            "type": "collection",
            "label": "Email size",
            "advanced": true
          },
          {
            "name": "hasAttachment",
            "type": "boolean",
            "label": "Only emails with attachments/media",
            "default": false,
            "advanced": true,
            "required": true
          },
          {
            "name": "format",
            "type": "select",
            "label": "Content format",
            "advanced": true,
            "required": true,
            "validate": {
              "enum": [
                "full",
                "raw",
                "metadata",
                "minimal"
              ]
            }
          }
        ],
        "interface": [
          {
            "name": "id",
            "type": "text",
            "label": "Message ID"
          },
          {
            "name": "threadId",
            "type": "text",
            "label": "Thread ID"
          },
          {
            "name": "internalDate",
            "type": "date",
            "label": "Date"
          },
          {
            "name": "subject",
            "type": "text",
            "label": "Subject",
            "condition": true
          },
          {
            "name": "fromName",
            "type": "text",
            "label": "From (name)",
            "condition": true
          },
          {
            "name": "fromEmail",
            "type": "text",
            "label": "From (email)",
            "condition": true
          },
          {
            "name": "to",
            "spec": {
              "spec": [
                {
                  "name": "name",
                  "type": "text",
                  "label": "Name"
                },
                {
                  "name": "email",
                  "type": "text",
                  "label": "Email"
                }
              ],
              "type": "collection"
            },
            "type": "array",
            "label": "To",
            "condition": true
          },
          {
            "name": "cc",
            "spec": [
              {
                "name": "email",
                "type": "email",
                "label": "Email"
              },
              {
                "name": "name",
                "type": "text",
                "label": "Name"
              }
            ],
            "type": "array",
            "label": "CC",
            "condition": true
          },
          {
            "name": "bcc",
            "spec": [
              {
                "name": "email",
                "type": "email",
                "label": "Email"
              },
              {
                "name": "name",
                "type": "text",
                "label": "Name"
              }
            ],
            "type": "array",
            "label": "BCC",
            "condition": true
          },
          {
            "name": "snippet",
            "type": "text",
            "label": "Snippet"
          },
          {
            "name": "fullTextBody",
